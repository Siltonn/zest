    "@zest/shared": "workspace:*",
    "@zest/simulator": "workspace:*",
    "ai": "^5.0.0",
    "zod": "^4.1.13"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "typescript": "^5.7.2"
  }
