# ─── Core (required) ────────────────────────────────────────────────────────
DATABASE_URL=postgres://zest:zest@localhost:5432/zest
REDIS_URL=redis://localhost:6379

# Encrypts platform OAuth tokens at rest. Generate: openssl rand -base64 32
ZEST_ENCRYPTION_KEY=change-me-at-least-16-chars
# Generate: openssl rand -base64 32
BETTER_AUTH_SECRET=change-me-at-least-16-chars

# ─── Server ─────────────────────────────────────────────────────────────────
# api | worker | all — `all` runs both roles in one process (default, fine for
# self-hosting and demos). Split into two containers only when you need to
# scale them independently.
MODE=all
PORT=4000
BETTER_AUTH_URL=http://localhost:4000
WEB_URL=http://localhost:3000

# Uploaded images are written here. Mount it as a volume in a container.
MEDIA_DIR=./media

# ─── Web ────────────────────────────────────────────────────────────────────
SERVER_URL=http://localhost:4000

# ─── Demo ───────────────────────────────────────────────────────────────────
# Seeds a workspace, the Pomelo network and an auto-logged-in demo user.
DEMO_MODE=true

# ─── AI (optional) ──────────────────────────────────────────────────────────
# Without a key the full platform loop still runs — compose, schedule, publish,
# simulated engagement, analytics. Planning and drafting need one.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# ─── Notifications (optional) ───────────────────────────────────────────────
# resend | smtp | console
MAIL_PROVIDER=console
RESEND_API_KEY=

# ─── Real platform connectors (optional, bring your own app credentials) ────
# Bluesky uses app passwords entered in the UI — nothing to configure here.
# ZEST_MASTODON_CLIENT_ID=
# ZEST_MASTODON_CLIENT_SECRET=
# ZEST_MASTODON_SCOPES=read write
