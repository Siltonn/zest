# ─── Core (required) ────────────────────────────────────────────────────────
DATABASE_URL=postgres://zest:zest@localhost:5432/zest
REDIS_URL=redis://localhost:6379

# Encrypts platform OAuth tokens at rest. Generate: openssl rand -base64 32
ZEST_ENCRYPTION_KEY=change-me-at-least-16-chars
# Generate: openssl rand -base64 32
BETTER_AUTH_SECRET=change-me-at-least-16-chars

# ─── Server ─────────────────────────────────────────────────────────────────
# api | worker | all — `all` runs both roles in one process (default, fine for
# self-hosting and demos). Split into two containers only when you need to
# scale them independently.
MODE=all
PORT=4000
WEB_URL=http://localhost:3000
# Where auth lives from a browser's point of view. Defaults to WEB_URL, which
# is right whenever the web app proxies the server (the standard topology).
# It is also the OAuth issuer that MCP clients discover, so it must be the
# public origin — an internal address here breaks Claude's custom connectors.
# BETTER_AUTH_URL=

# Uploaded images are written here. Mount it as a volume in a container.
MEDIA_DIR=./media

# The queue dashboard lives at http://localhost:4000/admin/queues and takes the
# same session as the app. Unset, its write actions — retry, remove, pause,
# drain — follow NODE_ENV: on while you develop, off on a deployed instance,
# where the page that retries a job can also drain a day of scheduled posts.
# COCKPIT_READONLY=true

# ─── Web ────────────────────────────────────────────────────────────────────
SERVER_URL=http://localhost:4000

# ─── Demo ───────────────────────────────────────────────────────────────────
# Seeds a workspace, the Pomelo network and a demo user — and signs every
# request in as that user, so the API needs no credentials. That is what makes
# `docker compose up` immediately clickable, and it is why you must set this to
# false before putting an instance anywhere reachable.
DEMO_MODE=true

# ─── AI (optional) ──────────────────────────────────────────────────────────
# Without a key the full platform loop still runs — compose, schedule, publish,
# simulated engagement, analytics. Planning and drafting need one.
#
# Any one of these is enough; they are checked in this order. OpenRouter is the
# quickest way to try it — one key reaches every model and you can cap spend.
OPENROUTER_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Optional. Model choice is deliberately not an in-app setting — the defaults
# are role-tiered (a capable model for strategy and writing, a cheap one for
# triage-volume work and the simulated audience) and picking one model for
# everything is usually worse. Override here if you know what you want; on
# OpenRouter use `vendor/model` slugs.
ZEST_MODEL=
ZEST_MODEL_CHEAP=

# Optional. The embedding model behind the assistant's semantic recall over
# past conversations. Defaults per provider (qwen3-embedding on OpenRouter,
# text-embedding-3-small on OpenAI); Anthropic has no embeddings API, so with
# only that key recall stays off — chat still works. Needs the pgvector
# Postgres image from docker-compose.yml. A custom model must honor the
# `dimensions` parameter or stay within pgvector's 2000-dimension index limit.
ZEST_EMBEDDING_MODEL=

# Which workspace `pnpm studio` acts on. Unset, it takes the oldest one, which
# on a seeded database is the demo workspace.
ZEST_STUDIO_WORKSPACE_ID=

# ─── Notifications (optional) ───────────────────────────────────────────────
# resend | smtp | console
# console prints to the log; smtp delivers (Mailpit is included in
# docker-compose and its web UI is at http://localhost:8025); resend needs a key.
MAIL_PROVIDER=smtp
SMTP_HOST=localhost
SMTP_PORT=1025
MAIL_FROM=Zest <zest@localhost>
RESEND_API_KEY=

# ─── Real platform connectors (optional, bring your own app credentials) ────
# Bluesky uses app passwords entered in the UI — nothing to configure here.
# ZEST_MASTODON_CLIENT_ID=
# ZEST_MASTODON_CLIENT_SECRET=
# ZEST_MASTODON_SCOPES=read write

# Which published image compose runs. `latest` is fine for trying it; pin a
# version for anything you would be annoyed to have change under you.
# ZEST_VERSION=0.1.0

# The server brings the database up to its own schema before serving. Turn this
# off only if a deploy pipeline runs migrations instead — the server will then
# refuse to start rather than run against a schema it does not match.
# AUTO_MIGRATE=false
