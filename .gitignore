node_modules/
dist/
.next/
.turbo/
# Mastra Studio's bundled dev server, and the libsql file it keeps traces in.
.mastra/
*.tsbuildinfo
# Regenerated by every `next dev`/`next build`, with content that differs
# between the two — tracking it means a permanently dirty tree.
next-env.d.ts

.env
.env.local
.env.*.local

.DS_Store
*.log
coverage/

# uploaded images
media/

# Working notes. `docs/` is what a reader of this repo gets; `docs-local/` is
# what only you get — presenter scripts, competitive teardowns, anything
# written for an audience of one. A whole directory rather than a list of
# filenames, so adding the next note is a `mv` and not a change here, and so
# nothing lands in the public set by forgetting to add a line.
docs-local/
